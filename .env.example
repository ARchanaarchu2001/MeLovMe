# Copy to .env (or .env.local) and fill in. Add the same values in Vercel -> Settings -> Environment Variables.

# MongoDB Atlas connection string (Atlas -> Database -> Connect -> Drivers)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
# Database name (optional, defaults to "melovme")
MONGODB_DB=melovme

# Firebase, which sends the login OTP by SMS.
# Firebase console -> Project settings -> General -> Your apps -> Web app -> SDK setup (Config).
# Leave empty in development to use a test OTP printed in the terminal running `npm run dev`.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Razorpay payment gateway (UPI apps, cards, netbanking).
# Razorpay Dashboard -> Account & Settings -> API Keys. Key ID and Key Secret go on separate lines.
# Test keys (rzp_test_...) take fake payments only; live keys (rzp_live_...) take real money.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay Dashboard -> Account & Settings -> Webhooks: the secret you type when adding the webhook
RAZORPAY_WEBHOOK_SECRET=

# Cloudinary, where product images uploaded in /admin/products are stored (MongoDB keeps only the links).
# Cloudinary -> Settings -> API Keys: "Cloud name" (a short code, not the account name), API key, API secret.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# EmailJS, which emails messages from the Contact page to the shop (https://dashboard.emailjs.com).
# Service ID: Email Services. Template ID: Email Templates. Public and Private key: Account -> General.
# Also turn on Account -> Security -> "Allow EmailJS API for non-browser applications".
# Leave empty to make the form open the visitor's own email app instead.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# The shop's public address, without a trailing slash, e.g. https://melovme.in
# Used for the product photo WhatsApp (and other apps) show when a product link is shared.
# On Vercel it defaults to the production domain; leave empty in development.
NEXT_PUBLIC_SITE_URL=
