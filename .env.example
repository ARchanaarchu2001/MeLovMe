# Copy to .env (or .env.local) and fill in. Add the same values in Vercel -> Settings -> Environment Variables.

# MongoDB Atlas connection string (Atlas -> Database -> Connect -> Drivers)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
# Database name (optional, defaults to "melovme")
MONGODB_DB=melovme

# Firebase, which sends the login OTP by SMS.
# Firebase console -> Project settings -> General -> Your apps -> Web app -> SDK setup (Config).
# Leave empty in development to use a test OTP printed in the terminal running `npm run dev`.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Razorpay payment gateway (UPI apps, cards, netbanking).
# Razorpay Dashboard -> Account & Settings -> API Keys. Key ID and Key Secret go on separate lines.
# Test keys (rzp_test_...) take fake payments only; live keys (rzp_live_...) take real money.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay Dashboard -> Account & Settings -> Webhooks: the secret you type when adding the webhook
RAZORPAY_WEBHOOK_SECRET=

# Cloudinary, where product images uploaded in /admin/products are stored (MongoDB keeps only the links).
# Cloudinary -> Settings -> API Keys: "Cloud name" (a short code, not the account name), API key, API secret.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
